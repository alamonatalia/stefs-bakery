---
interface Props {
  message: string;
}

const { message } = Astro.props as Props;
const phone = "34653089301";
const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<section class="bg-[#fbf7f3] text-center -mt-10 pt-14 pb-8 lg:-mt-4 lg:pb-20 lg:-mt-14 lg:pt-20">
  <p class="font-bold lg:text-xl lg:mb-2">¿Tienes dudas o consultas?</p>
  <p class="text-[13px] lg:text-base">
    <a href={href} target="_blank" rel="noopener noreferrer" class="underline">Contáctanos por aquí</a> y te responderemos lo antes posible.
  </p>
</section>
