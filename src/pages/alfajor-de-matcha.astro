---
const logoStefs = "/stefs-bakery/stefs.svg";
const arrow = "/stefs-bakery/arrow.svg";
const postre2 = "/stefs-bakery/alfajor-matcha-3-macro-edit-compress.png";


import Layout from "../layouts/Layout.astro";
---

<Layout>

	<header class="flex items-center py-4 mb-4"> 
		<a href="/stefs-bakery">
			<img src={arrow} alt="logo" class="h-7 pl-4 w-auto mx-auto mb-4 z-20 relative" />
		</a>
		<div class="w-full">
			<img src={logoStefs} alt="logo" class="w-auto h-7 mx-auto mb-4 z-20 relative" />
		</div>
	</header>
	
	<section class="aspect-video bg-gray-200 relative">
		<img src={postre2} alt="logo" class="w-full h-full object-cover -mt-8 mb-4 z-10" />
	</section>

	<section class="bg-white -mt-8 relative rounded-4xl p-8">
		<h1 class="text-lg font-semibold mb-4">ALFAJOR DE <span class="bg-[#9fa968] text-white px-1.5 py-0">MATCHA</span> CON MANJAR DE LÚCUMA</h1>
		<p class="leading-[1.5] text-[12px]">Deliciosa galleta de maicena con auténtico MATCHA llena de energía y antioxidentes. Relleno de nuestro cremoso manjar de lúcuma, trozos de fresa que equilibran cada bocado. Es ligero, fresco y nutritivo. </p>


		<p class="leading-[1.5] text-[12px] mt-3">Lo querras comer antes o después de entrenar. ¡Energía de la buena!</p>

		<p class="text-[12px] font-semibold tracking-wider mt-6 mb-2">ELIGE SU PRESENTACIÓN</p>
		<div class="grid grid-cols-2 gap-4">
			<button
				data-label="Individual"
				class="presentation-option border border-solid border-[#8c7d6d] rounded-xl p-4 text-center cursor-pointer transition-all"
			>
				<p class="text-sm">Individual</p>
				<p class="text-xl">€7</p>
			</button>
			<button
				data-label="Caja de 6 unid."
				class="presentation-option border border-solid border-[#8c7d6d] rounded-xl p-4 text-center cursor-pointer transition-all"
			>
				<p class="text-sm">Pack de 6 unid.</p>
				<p class="text-xl">€42</p>
			</button>
		</div>
		<button id="whatsapp-btn" class="bg-[#5f8190] text-white rounded-full font-semibold text-center py-4 block w-full mt-8 mb-2 opacity-30 transition-opacity">HAZ TU PEDIDO</button>
	</section>


	<section class="bg-[#fbf7f3] text-center -mt-10 pt-14 pb-8 ">
		<p class="font-bold">¿Tienes dudas o consultas?</p>
		<p class="text-[13px]">Contáctanos y te responderemos lo antes posible.</p>
	</section>

	<div id="toast" class="fixed top-4 left-1/2 bg-[#abb96a] shadow-3xl text-white text-center text-[13px] rounded-lg p-4 shadow-lg opacity-0 transition-all duration-300 pointer-events-none max-w-md z-50" style="transform: translateX(-50%) translateY(-3rem);">
		Por favor elige una presentación primero.
	</div>

	<footer class="bg-[#8c7d6e] px-4 py-8 text-white/50 text-center text-[11px]">
		<p class="mb-3">Hechos con ❤️ por Stef's Bakery, Málaga, España</p>
		<a href="https://www.instagram.com/stefs_bakery/" class="underline">Instagram</a>
	</footer>

</Layout>

<style>
	.presentation-option.selected {
		background-color: #c9AB6A;
		color: white;
		border-color: #9e8550;
	}

	#toast.show {
		opacity: 1;
		transform: translateX(-50%) translateY(0) !important;
	}
</style>

<script>
	const options = document.querySelectorAll(".presentation-option");
	const btn = document.getElementById("whatsapp-btn");
	const toast = document.getElementById("toast");
	const phone = "34653089301";
	let selectedLabel = "";

	function showToast() {
		toast?.classList.add("show");
		setTimeout(() => {
			toast?.classList.remove("show");
		}, 3000);
	}

	options.forEach(option => {
		option.addEventListener("click", () => {
			options.forEach(o => o.classList.remove("selected"));
			option.classList.add("selected");
			selectedLabel = option.getAttribute("data-label") ?? "";
			btn?.classList.remove("opacity-30");
			btn?.classList.add("opacity-100");
		});
	});

	btn?.addEventListener("click", () => {
		if (!selectedLabel) {
			showToast();
			return;
		}
		const message = encodeURIComponent(
			`Hola Stef's, quiero hacer un pedido de Alfajor de Matcha "${selectedLabel}"`
		);
		window.location.href = `https://wa.me/${phone}?text=${message}`, "_blank";
	});
</script>


</Layout>