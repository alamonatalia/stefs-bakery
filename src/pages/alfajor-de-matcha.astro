---
const basePath = "/";
const logoStefs = `${basePath}stefs.svg`;
const arrow = `${basePath}arrow.svg`;

import postreWebp from "../assets/products/alfajor-matcha.webp?url";
import postreJpg from "../assets/products/alfajor-matcha.jpg?url";

import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import ContactSection from "../components/ContactSection.astro";
---

<Layout
	title="Alfajor de matcha"
	description="Delicioso alfajor de matcha con manjar de lúcuma."
>

	<header class="flex items-center py-4 mb-4 lg:max-w-4xl lg:mx-auto lg:bg-white lg:rounded-2xl"> 
		<a href={basePath}>
			<img src={arrow} alt="logo" class="h-7 pl-4 w-auto mx-auto mb-4 z-20 relative" />
		</a>
		<div class="w-full">
			<a href={basePath}>
				<img src={logoStefs} alt="logo" class="w-auto h-7 mx-auto mb-4 z-20 relative" />
			</a>
		</div>
	</header>
	
	<section class="aspect-video relative lg:max-w-4xl lg:mx-auto">
		<picture>
			<source srcset={postreWebp} type="image/webp" />
			<img src={postreJpg} alt="Alfajor de matcha artesanal" class="w-full h-full object-cover -mt-8 mb-4 z-10 lg:rounded-b-4xl" />
		</picture>
	</section>

	<section class="bg-white -mt-8 relative rounded-4xl p-8 lg:max-w-2xl lg:mx-auto lg:-mt-14 lg:p-12 lg:border lg:border-solid lg:border-[#eedfca]">
		<h1 class="text-lg font-semibold mb-4 lg:text-xl">ALFAJOR DE <span class="bg-[#9fa968] text-white px-1.5 py-0">MATCHA</span> CON MANJAR DE LÚCUMA</h1>
		<p class="leading-[1.5] text-[12px] lg:text-base">Deliciosa galleta de maicena con auténtico MATCHA llena de energía y antioxidentes. Relleno de nuestro cremoso manjar de lúcuma, trozos de fresa que equilibran cada bocado. Es ligero, fresco y nutritivo. </p>


		<p class="leading-[1.5] text-[12px] mt-3 lg:text-base">Lo querras comer antes o después de entrenar. ¡Energía de la buena!</p>

		<p class="text-[12px] font-semibold tracking-wider mt-6 mb-2 lg:text-base">ELIGE TU PRESENTACIÓN</p>
		<div class="grid grid-cols-2 gap-4">
			<button
				data-label="Individual"
				class="presentation-option border border-solid border-[#8c7d6d] rounded-xl p-4 text-center cursor-pointer transition-all lg:hover:bg-[#f2f2f2]"
			>
				<p class="text-sm lg:text-base">Individual</p>
				<p class="text-xl lg:text-2xl">€7</p>
			</button>
			<button
				data-label="Pack de 4 unid."
				class="presentation-option border border-solid border-[#8c7d6d] rounded-xl p-4 text-center cursor-pointer transition-all lg:hover:bg-[#f2f2f2]"
			>
				<p class="text-sm lg:text-base">Pack de 4 unid.</p>
				<p class="text-xl lg:text-2xl">€28</p>
			</button>
		</div>
		<button id="whatsapp-btn" class="bg-[#5f8190] text-white rounded-full font-semibold text-center py-4 block w-full mt-8 mb-2 opacity-30 transition-opacity cursor-pointer lg:text-xl lg:py-6">HAZ TU PEDIDO</button>
	</section>


	<ContactSection message="Hola Stef's, tengo una consulta sobre el Alfajor con manjar de lúcuma" />

	<div id="toast" class="fixed top-4 left-1/2 bg-[#abb96a] shadow-3xl text-white text-center text-[13px] rounded-lg p-4 shadow-lg opacity-0 transition-all duration-300 pointer-events-none max-w-md z-50" style="transform: translateX(-50%) translateY(-3rem);">
		Por favor elige una presentación primero.
	</div>

	<Footer />

</Layout>

<style>
	.presentation-option.selected {
		background-color: #c9AB6A;
		color: white;
		border-color: #9e8550;
	}

	#toast.show {
		opacity: 1;
		transform: translateX(-50%) translateY(0) !important;
	}
</style>

<script>
	const options = document.querySelectorAll(".presentation-option");
	const btn = document.getElementById("whatsapp-btn");
	const toast = document.getElementById("toast");
	const phone = "34653089301";
	let selectedLabel = "";

	function showToast() {
		toast?.classList.add("show");
		setTimeout(() => {
			toast?.classList.remove("show");
		}, 3000);
	}

	options.forEach(option => {
		option.addEventListener("click", () => {
			options.forEach(o => o.classList.remove("selected"));
			option.classList.add("selected");
			selectedLabel = option.getAttribute("data-label") ?? "";
			btn?.classList.remove("opacity-30");
			btn?.classList.add("opacity-100");
		});
	});

	btn?.addEventListener("click", () => {
		if (!selectedLabel) {
			showToast();
			return;
		}
		const message = encodeURIComponent(
			`Hola Stef's, quiero hacer un pedido de Alfajor de Matcha "${selectedLabel}"`
		);
		window.open(`https://wa.me/${phone}?text=${message}`, "_blank");
	});
</script>