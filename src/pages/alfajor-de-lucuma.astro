---
const basePath = "/";
const logoStefs = `${basePath}stefs.svg`;
const arrow = `${basePath}arrow.svg`;

import postreWebp from "../assets/alfajor-lucuma.webp?url";
import postreJpg from "../assets/alfajor-lucuma.jpg?url";

import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
	title="Alfajor de lúcuma" 
	description="Delicioso alfajor de maicena con manjar de lúcuma."
>

	<header class="flex items-center py-4 mb-4"> 
		<a href={basePath}>
			<img src={arrow} alt="logo" class="h-7 pl-4 w-auto mx-auto mb-4 z-20 relative" />
		</a>
		<div class="w-full">
			<img src={logoStefs} alt="logo" class="w-auto h-7 mx-auto mb-4 z-20 relative" />
		</div>
	</header>
	
	<section class="aspect-video bg-gray-200 relative">
		<picture>
			<source srcset={postreWebp} type="image/webp" />
			<img src={postreJpg} alt="Alfajor de lúcuma artesanal" class="w-full h-full object-cover -mt-8 mb-4 z-10" />
		</picture>
	</section>

	<section class="bg-white -mt-8 relative rounded-4xl p-8">
		<h1 class="text-lg font-semibold mb-3">ALFAJOR CON MANJAR DE LÚCUMA</h1>
		<p class="leading-[1.5] text-[12px]">El clásico alfajor peruano de maicena en forma de galleta, lleno con manjar de lúcuma que se funde en tu boca desde la primera cucharada. La combinación perfecta de texturas diseñada para comerse en cucharadas. </p>
		<p class="leading-[1.5] text-[12px] mt-3">¡Un capricho dulce e irresistible!</p>

		<p class="text-[12px] font-semibold tracking-wider mt-6 mb-2">ELIGE TU PRESENTACIÓN</p>
		<div class="grid grid-cols-2 gap-4">
			<button
				data-label="Individual"
				class="presentation-option border border-solid border-[#8c7d6d] rounded-xl p-4 text-center cursor-pointer transition-all"
			>
				<p class="text-sm">Individual</p>
				<p class="text-xl">€6</p>
			</button>
			<button
				data-label="Pack de 6 unid."
				class="presentation-option border border-solid border-[#8c7d6d] rounded-xl p-4 text-center cursor-pointer transition-all"
			>
				<p class="text-sm">Pack de 6 unid.</p>
				<p class="text-xl">€36</p>
			</button>
		</div>
		<button id="whatsapp-btn" class="bg-[#5f8190] text-white rounded-full font-semibold text-center py-4 block w-full mt-8 mb-2 opacity-30 transition-opacity">HAZ TU PEDIDO</button>
	</section>

	<section class="bg-[#fbf7f3] text-center -mt-10 pt-14 pb-8">
		<p class="font-bold">¿Tienes dudas o consultas?</p>
		<p class="text-[13px]">Contáctanos y te responderemos lo antes posible.</p>
	</section>

	<div id="toast" class="fixed top-4 left-1/2 bg-[#abb96a] shadow-3xl text-white text-center text-[13px] rounded-lg p-4 shadow-lg opacity-0 transition-all duration-300 pointer-events-none max-w-md z-50" style="transform: translateX(-50%) translateY(-3rem);">
		Por favor elige una presentación primero.
	</div>

	<Footer />

</Layout>

<style>
	.presentation-option.selected {
		background-color: #c9AB6A;
		color: white;
		border-color: #9e8550;
	}

	#toast.show {
		opacity: 1;
		transform: translateX(-50%) translateY(0) !important;
	}
</style>

<script>
	const options = document.querySelectorAll(".presentation-option");
	const btn = document.getElementById("whatsapp-btn");
	const toast = document.getElementById("toast");
	const phone = "34653089301";
	let selectedLabel = "";

	function showToast() {
		toast?.classList.add("show");
		setTimeout(() => {
			toast?.classList.remove("show");
		}, 3000);
	}

	options.forEach(option => {
		option.addEventListener("click", () => {
			options.forEach(o => o.classList.remove("selected"));
			option.classList.add("selected");
			selectedLabel = option.getAttribute("data-label") ?? "";
			btn?.classList.remove("opacity-30");
			btn?.classList.add("opacity-100");
		});
	});

	btn?.addEventListener("click", () => {
		if (!selectedLabel) {
			showToast();
			return;
		}
		const message = encodeURIComponent(
			`Hola Stef's, quiero hacer un pedido de Alfajor con manjar de lúcuma "${selectedLabel}"`
		);
		window.location.href = `https://wa.me/${phone}?text=${message}`, "_blank";
	});
</script>