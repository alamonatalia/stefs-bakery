---

const lucumaHref = "/alfajor-de-lucuma";
const matchaHref = "/alfajor-de-matcha";

const logoStefsBakery = "/stefs-bakery.svg";
const logoStefsBakeryS = "/stefs-bakery-s.svg";
const deliveryIcon = "/delivery.svg";

import bgHeroWebp from "../assets/hero/hero-pasteleria-peruana.webp?url";
import bgHeroJpg from "../assets/hero/hero-pasteleria-peruana.jpg?url";
import lucumaWebp from "../assets/products/alfajor-lucuma.webp?url";
import lucumaJpg from "../assets/products/alfajor-lucuma.jpg?url";
import matchaWebp from "../assets/products/alfajor-matcha.webp?url";
import matchaJpg from "../assets/products/alfajor-matcha.jpg?url";

import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

---

<Layout
	title="Alfajores Peruanos Artesanales en Málaga"
	description="Pastelería artesanal peruana en Málaga especializada en alfajores de lúcuma, matcha y postres tradicionales."
>

	<header>
		<img src={logoStefsBakery} alt="Logo de Stef's Bakery" class="w-32 h-auto mx-auto mb-4 -mt-4 z-20 relative" width="128" height="128" />
	</header>
	
	<section aria-labelledby="hero-title">
		<picture>
			<source srcset={bgHeroWebp} type="image/webp" />
			<img
				src={bgHeroJpg}
				alt="Alfajores artesanales de Stef's Bakery, pastelería peruana en Málaga"
				class="w-full h-auto -mt-10 mb-4 z-10"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				width="1080"
  				height="720"
			/>
		</picture>
		<div class="w-[80%] mx-auto px-6 py-5 pb-4 bg-[#F7F2ED]/95 -mt-12 z-20 relative text-center text-lg rounded-2xl">
			<h1 id="hero-title" class="mb-2 text-xl sb-special">
				Alfajores peruanos artesanales en Málaga
			</h1>
			<p class="text-sm">Esencia peruana, bienestar y memoria.</p>	
			<img src={logoStefsBakeryS} class="w-4 h-auto mx-auto rotate-90" alt="" aria-hidden="true" />
		</div>
	</section>
	
	<section class="px-5 py-4">
		<h2 class="sb-special text-[18px] uppercase mt-4 mb-3">Nuestros productos</h2>
		<div class="grid grid-cols-2 gap-3">
			<a href={lucumaHref} aria-label="Ver alfajor artesanal de lúcuma" class="border border-solid border-[#d2c3a8] rounded-lg overflow-hidden block">
				<picture>
					<source srcset={lucumaWebp} type="image/webp" />
					<img src={lucumaJpg} alt="Alfajor artesanal de lúcuma elaborado por Stef's Bakery" loading="lazy" decoding="async" class="w-full h-auto scale-100" width="167" height="218"/>
				</picture>
				<div class="p-3">
					<h3 class="text-[13px] font-semibold mb-2">ALFAJOR de LÚCUMA</h3>
					<p class="text-[12px] leading-[1.2]">Alfajor con manjar de lúcuma.</p>
				</div>
			</a>
			<a href={matchaHref} aria-label="Ver alfajor artesanal de matcha" class="border border-solid border-[#d2c3a8] rounded-lg overflow-hidden block">
				<picture>
					<source srcset={matchaWebp} type="image/webp" />
					<img src={matchaJpg} alt="Alfajor artesanal de matcha con manjar de lúcuma" loading="lazy" decoding="async" class="w-full h-auto" width="167" height="218"/>
				</picture>
				<div class="p-3">
					<h3 class="text-[13px] font-semibold mb-2">ALFAJOR de <span class="bg-[#9fa968] text-white px-1 py-0">MATCHA</span></h3>
					<p class="text-[12px] leading-[1.2]">Alfajor con matcha y manjar de lúcuma. </p>
				</div>
			</a>
		</div>
	</section>
	<section class="px-12 py-4 mb-4">
		<div class="flex items-center gap-4 bg-[#eaedef] text-[#638489] p-4 rounded-2xl">
			<img src={deliveryIcon} alt="" aria-hidden="true" class="w-12 h-auto" />
			<div>
				<p class="font-bold text-[14px]">Envíos en Málaga centro</p>
				<p class="text-[12px]">Haz tu pedido 24hs antes</p>
			</div>
		</div>
	</section>
	<Footer />
  
</Layout>