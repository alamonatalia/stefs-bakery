---
const basePath = "/";
const lucumaHref = `${basePath}alfajor-de-lucuma`;
const matchaHref = `${basePath}alfajor-de-matcha`;
const logoStefsBakery = `${basePath}stefs-bakery.svg`;
const logoStefsBakeryS = `${basePath}stefs-bakery-s.svg`;
const bgHero = `${basePath}composicion-4-edit3-compress.png`;
const postre1 = `${basePath}alfajor-maicena-2-edit-compress2.png`;
const postre2 = `${basePath}alfajor-matcha-1-edit-compress2.png`;
const deliveryIcon = `${basePath}delivery.svg`;



import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Stef's Bakery | Pastelería Peruana en Málaga"
	description="Pastelería artesanal peruana en Málaga. Descubre nuestros alfajores de lúcuma y matcha elaborados con ingredientes seleccionados."
>

	<header>
		<img src={logoStefsBakery} alt="logo" class="w-32 h-auto mx-auto mb-4 -mt-4 z-20 relative" />
	</header>
	
	<section>
		<img src={bgHero} alt="logo" class="w-full h-auto -mt-10 mb-4 z-10" />
		<div class="w-[70%] mx-auto px-10 py-5 pb-4 bg-[#F7F2ED]/95 -mt-12 z-20 relative text-center text-lg rounded-2xl">
			<h1 class="mb-2 text-xl sb-special">Esencia peruana, bienestar y memoria.</h1>
			<img src={logoStefsBakeryS} class="w-4 h-auto mx-auto rotate-90" />
		</div>
	</section>
	
	<section class="px-5 py-4">
		<p class="sb-special text-[18px] uppercase mt-4 mb-3">Nuestros productos</p>
		<div class="grid grid-cols-2 gap-3">
			<a href={lucumaHref} class="border border-solid border-[#d2c3a8] rounded-lg overflow-hidden block">
				<img src={postre1} class="w-full h-auto scale-100"/>
				<div class="p-3">
					<h2 class="text-[13px] font-semibold mb-2">ALFAJOR de LÚCUMA</h2>
					<p class="text-[12px] leading-[1.2]">Alfajor con manjar de lúcuma.</p>
				</div>
			</a>
			<a href={matchaHref} class="border border-solid border-[#d2c3a8] rounded-lg overflow-hidden block">
				<img src={postre2} class="w-full h-auto"/>
				<div class="p-3">
					<h2 class="text-[13px] font-semibold mb-2">ALFAJOR de <span class="bg-[#9fa968] text-white px-1 py-0">MATCHA</span></h2>
					<p class="text-[12px] leading-[1.2]">Alfajor con matcha y manjar de lúcuma. </p>
				</div>
			</a>
		</div>
	</section>
	<section class="px-12 py-4 mb-4">
		<div class="flex items-center gap-4 bg-[#eaedef] text-[#638489] p-4 rounded-2xl">
			<img src={deliveryIcon} alt="delivery" class="w-12 h-auto" />
			<div>
				<p class="font-bold text-[14px]">Envíos en Málaga centro</p>
				<p class="text-[12px]">Haz tu pedido 24hs antes</p>
			</div>
		</div>
	</section>
	<footer class="bg-[#8c7d6e] px-4 py-8 text-white/50 text-center text-[11px]">
		<p class="mb-3">Hechos con ❤️ por Stef's Bakery, Málaga, España</p>
		<a href="https://www.instagram.com/stefs.bakerymlg/" class="underline">Instagram</a> 
	</footer>
  
</Layout>